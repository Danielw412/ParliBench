{
  "name": "parlibench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"wrangler dev --port 8787\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "build": "vite build && node scripts/pages.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir .worker-build",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run build:worker",
    "db:migrate": "wrangler d1 migrations apply parlibench --local",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "node scripts/setup.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "types": "wrangler types worker/env.d.ts --include-runtime false",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260911.0-alpha",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
